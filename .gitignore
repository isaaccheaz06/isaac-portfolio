Thumbs.db

# The full-resolution source for assets/images/isaac-about.webp. Kept on disk
# so the derivative can be regenerated; 13MB has no business in a static site,
# and git would keep every version of it forever.
assets/images/Me.JPG
assets/images/Me2.JPG
assets/images/Me3.JPG

# Full-resolution originals awaiting a web-sized derivative, for the same
# reason: 4-5MB each, and nothing references them. The .webp beside a
# project-page-img.jpg is what media.js actually loads.
assets/butterfly-pavilion/project-page-img.jpg
assets/suzume-cnc-stool/project-page-img.jpg

# The Rhino source the GLB was exported from. 9.3MB, nothing references it,
# and vase-repaired.glb is what the page actually loads -- same reason the
# full-resolution photographs above are kept on disk rather than in git.
assets/digital-kintsugi/mesh.3dm

# Camera/edit masters for the two project films, for the same reason: 80MB and
# 438MB. projectfilm-web.mp4 and projectfilm-poster.webp beside each one are
# what the pages load, and those ARE tracked -- only the masters are listed.
assets/butterfly-pavilion/projectfilm.mov
assets/suzume-cnc-stool/projectfilm.mp4
